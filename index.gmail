<!DOCTYPE html>
<html lang="uz">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Unashtirish marosimiga taklifnoma</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;1,9..144,400;1,9..144,600&family=Figtree:wght@400;600&display=swap">
<style>
:root{--bg:#FAF1EE;--ink:#3A0C1A;--muted:#7A4A56;--accent:#8E1B3A;--gold:#A9741A;--line:#E3CBC7;
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#3A0C1A;--ink:#FBEFEA;--muted:#D9B2B8;--accent:#F08A9B;--gold:#E3B04B;--line:#6B2438}}
:root[data-theme="dark"]{--bg:#3A0C1A;--ink:#FBEFEA;--muted:#D9B2B8;--accent:#F08A9B;--gold:#E3B04B;--line:#6B2438}
html{scroll-padding-top:env(safe-area-inset-top,0px);height:100%}
*{box-sizing:border-box}
body{margin:0;min-height:100%;background:var(--bg);color:var(--ink);font-family:"Figtree",system-ui,sans-serif;line-height:1.6;display:flex;justify-content:center;overflow-x:hidden}
.stage{width:100%;max-width:480px;min-height:100vh;min-height:100svh;padding:28px 30px 24px;display:flex;flex-direction:column;position:relative}
.glow{position:absolute;left:50%;top:70px;width:340px;height:340px;margin-left:-170px;border-radius:50%;background:radial-gradient(circle,var(--accent) 0,transparent 68%);opacity:.22;animation:pulse 6s ease-in-out infinite;pointer-events:none}
@keyframes pulse{50%{opacity:.4;transform:scale(1.12)}}
.pgs{flex:1;display:flex;position:relative}
.pg{display:none;width:100%}
.pg.on{display:flex;flex-direction:column;justify-content:center;animation:in .7s ease both}
@keyframes in{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:none}}
.pair{display:flex;justify-content:center;margin:0 0 34px}
.ph{width:124px;height:178px;border:1px solid var(--gold);border-radius:62px 62px 0 0;overflow:hidden;display:grid;place-items:center;font:italic 600 3rem "Fraunces",Georgia,serif;color:var(--gold);background:color-mix(in srgb,var(--accent) 16%,var(--bg))}
.ph+.ph{margin:30px 0 0 -16px}
.ph img{width:100%;height:100%;object-fit:cover;display:block}
h1{margin:0;font:italic 500 4.4rem/.95 "Fraunces",Georgia,serif;letter-spacing:-.02em}
h1 span{display:block;clip-path:inset(0 100% 0 0);animation:wipe 1.3s cubic-bezier(.6,0,.2,1) forwards}
h1 span+span{padding-left:1.1em;color:var(--accent);animation-delay:.5s}
@keyframes wipe{to{clip-path:inset(0 0 0 0)}}
.sub{margin:24px 0 0;color:var(--muted);font-size:1.05rem}
.sub b{color:var(--gold);font-weight:600}
h2{margin:0 0 26px;font:italic 500 2.3rem/1.1 "Fraunces",Georgia,serif}
.fact{margin:0 0 22px}
.fact dt{color:var(--gold);font-weight:600;font-size:.95rem}
.fact dd{margin:2px 0 0;font:500 1.45rem/1.3 "Fraunces",Georgia,serif}
.cd{display:flex;margin:34px 0 0;border-top:1px solid var(--line);padding-top:18px}
.cd div{flex:1;font-size:.85rem;color:var(--muted)}
.cd div+div{border-left:1px solid var(--line);padding-left:14px}
.cd b{display:block;font:italic 500 2.4rem/1 "Fraunces",Georgia,serif;color:var(--accent)}
.tl{list-style:none;margin:0 0 32px;padding:0 0 0 22px;border-left:1px solid var(--gold)}
.tl li{position:relative;padding:0 0 20px;font:500 1.3rem/1.3 "Fraunces",Georgia,serif}
.tl li::before{content:"";position:absolute;left:-28px;top:.45em;width:11px;height:11px;border-radius:50%;background:var(--bg);border:2px solid var(--accent)}
.tl time{display:block;font:600 .95rem "Figtree",sans-serif;color:var(--gold)}
.btn{display:inline-block;background:var(--accent);color:var(--bg);text-decoration:none;font-weight:600;padding:14px 28px;border-radius:40px;transition:transform .2s}
.btn:hover{transform:translateY(-2px)}
.btn:focus-visible,.nb:focus-visible{outline:3px solid var(--gold);outline-offset:3px}
.note{margin:18px 0 0;color:var(--muted);font-size:.95rem}
.nav{display:flex;align-items:center;justify-content:space-between;padding-top:18px}
.nb{width:46px;height:46px;border-radius:50%;border:1px solid var(--gold);background:none;color:var(--gold);font-size:1.6rem;line-height:1;cursor:pointer}
.nb:disabled{opacity:.3;cursor:default}
.dots{display:flex;gap:8px}
.dots i{width:8px;height:8px;border-radius:50%;background:var(--line);transition:background .3s,transform .3s}
.dots i.on{background:var(--accent);transform:scale(1.4)}
.pin{position:relative;width:52px;margin:0 0 22px}
.pin svg{width:40px;display:block;position:relative}
.pin span{position:absolute;left:-4px;bottom:-6px;width:48px;height:14px;border:1px solid var(--accent);border-radius:50%;animation:ring 2.4s ease-out infinite}
@keyframes ring{from{transform:scale(.4);opacity:.9}to{transform:scale(1.8);opacity:0}}
.addr{margin:0;font:italic 500 2rem/1.2 "Fraunces",Georgia,serif}
.sub2{margin:6px 0 30px;color:var(--muted);font-size:1.05rem}
.tel{color:var(--accent);font-weight:600;white-space:nowrap}
@media (max-width:380px){h1{font-size:3.6rem}}
@media (prefers-reduced-motion:reduce){*{animation:none!important}h1 span{clip-path:none}}
</style>
</head>
<body>
<main class="stage">
 <div class="glow" aria-hidden="true"></div>
 <div class="pgs">
  <section class="pg on" id="muqova">
   <div class="pair"><div class="ph"><img src="data:image/jpeg;base64," alt="Kuyov surati"></div><div class="ph"><img src="data:image/jpeg;base64," alt="Kelin surati"></div></div>
   <h1><span>Sardor</span><span>& Aziza</span></h1>
   <p class="sub">Sizni <b>unashtirish marosimimizga</b> taklif qilamiz</p>
  </section>
  <section class="pg" id="tafsilot">
   <h2>Bizning kunimiz</h2>
   <dl>
    <div class="fact"><dt>Sana</dt><dd>12-dekabr, shanba</dd></div>
    <div class="fact"><dt>Vaqt</dt><dd>Soat 15:00 da</dd></div>
    <div class="fact"><dt>Manzil</dt><dd>“Navbahor” to‘yxonasi, Nukus shahri</dd></div>
   </dl>
   <div class="cd"><div><b id="d">0</b>kun</div><div><b id="h">0</b>soat</div><div><b id="m">0</b>daqiqa</div><div><b id="s">0</b>soniya</div></div>
  </section>
  <section class="pg" id="dastur">
   <h2>Kun dasturi</h2>
   <ol class="tl"><li><time>15:00</time>Mehmonlarni kutib olish</li><li><time>15:30</time>Unashtirish marosimi</li><li><time>16:30</time>Dasturxon</li><li><time>19:00</time>Tabriklar va raqs</li></ol>
   <div><a class="btn" href="tel:+998900000000">Kelishingizni tasdiqlang</a></div>
   <p class="note">Siz bilan birga bayramimiz yanada quvonchli bo‘ladi.</p>
  </section>
  <section class="pg" id="manzil">
   <div class="pin" aria-hidden="true"><span></span><svg viewBox="0 0 40 52"><path d="M20 2C10 2 3 9.500 3 19c0 12 17 31 17 31s17-19 17-31C37 9.500 30 2 20 2Z" fill="none" stroke="var(--gold)" stroke-width="2"/><circle cx="20" cy="19" r="6" fill="var(--accent)"/></svg></div>
   <h2>Manzil</h2>
   <p class="addr">“Navbahor” to‘yxonasi</p>
   <p class="sub2">Nukus shahri</p>
   <div><a class="btn" target="_blank" rel="noopener" href="https://www.google.com/maps/search/?api=1&amp;query=Navbahor+toyxonasi+Nukus">Xaritada ochish</a></div>
   <p class="note">Yo‘l topolmasangiz, qo‘ng‘iroq qiling: <a class="tel" href="tel:+998900000000">+998 90 000 00 00</a></p>
  </section>
 </div>
 <nav class="nav" aria-label="Sahifalar"><button class="nb" id="prev" aria-label="Oldingi sahifa">‹</button><span class="dots" aria-hidden="true"><i></i><i></i><i></i><i></i></span><button class="nb" id="next" aria-label="Keyingi sahifa">›</button></nav>
</main>
<script>
(function(){var ids=["muqova","tafsilot","dastur","manzil"],pg=ids.map(function(i){return document.getElementById(i)}),dots=document.querySelectorAll(".dots i"),pv=document.getElementById("prev"),nx=document.getElementById("next"),cur=0;
function show(i,upd){cur=Math.max(0,Math.min(3,i));pg.forEach(function(p,k){p.classList.toggle("on",k===cur)});dots.forEach(function(d,k){d.classList.toggle("on",k===cur)});pv.disabled=cur===0;nx.disabled=cur===3;if(upd){try{history.replaceState(null,"","#"+ids[cur])}catch(e){}}}
pv.onclick=function(){show(cur-1,1)};nx.onclick=function(){show(cur+1,1)};
var sx=null;document.addEventListener("touchstart",function(e){sx=e.touches[0].clientX},{passive:true});document.addEventListener("touchend",function(e){if(sx===null)return;var dx=e.changedTouches[0].clientX-sx;sx=null;if(Math.abs(dx)>60)show(cur+(dx<0?1:-1),1)});
document.addEventListener("keydown",function(e){if(e.key==="ArrowRight")show(cur+1,1);if(e.key==="ArrowLeft")show(cur-1,1)});
function fromHash(){var k=ids.indexOf(location.hash.slice(1));show(k<0?0:k,0)}window.addEventListener("hashchange",fromHash);fromHash();})();
(function(){var t=new Date(2026,11,12,15,0,0).getTime();function u(){var x=Math.max(0,t-Date.now());var v={d:Math.floor(x/864e5),h:Math.floor(x%864e5/36e5),m:Math.floor(x%36e5/6e4),s:Math.floor(x%6e4/1e3)};for(var k in v){document.getElementById(k).textContent=v[k]}}u();setInterval(u,1000)})();
</script>
</body>
</html>
